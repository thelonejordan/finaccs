# Django settings
SECRET_KEY=generate-a-secure-random-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (MySQL)
DATABASE_URL=mysql://user:password@host:3306/dbname

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8000,https://yourdomain.com

# Development mode (enables API docs, django-extensions)
DEV_MODE=0

# Redis cache (optional - improves API response times)
REDIS_ENABLED=0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# Note: File passwords are stored in ExtractionPipeline model, not env vars

# Frontend (copy to frontend/.env)
VITE_API_BASE=http://localhost:8000
