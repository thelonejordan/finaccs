# Django settings
SECRET_KEY=generate-a-secure-random-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (MySQL)
DATABASE_URL=mysql://user:password@host:3306/dbname

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8000,https://yourdomain.com
# Set to true to allow all origins (useful for tunneling)
CORS_ALLOW_ALL_ORIGINS=false

# Development mode (enables API docs, django-extensions)
DEV_MODE=0

# Tunneling support (ngrok, cloudflared)
# Add tunnel hosts to ALLOWED_HOSTS: .trycloudflare.com,.ngrok-free.app,.ngrok.io
# Vite dev server allowed hosts (comma-separated)
VITE_ALLOWED_HOSTS=

# Redis cache (optional - improves API response times)
REDIS_ENABLED=0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# Note: File passwords are stored in ExtractionPipeline model, not env vars

# Frontend (set when using separate frontend/backend tunnels)
VITE_API_BASE=
